POSTGRES_PASSWORD=password
FRONTEND_PORT=3000
APP_BASE_URL=http://localhost:3000
APP_ENV=development
# Comma-separated email addresses allowed to access the admin overview.
# ADMIN_EMAILS=admin@example.com

# Override to use an existing PostgreSQL server.
# Inside Docker, localhost is the container, not the host machine.
# DATABASE_URL=postgresql://postgres:password@host.docker.internal/postgres

# Configure SMTP to deliver links by email instead of the development console.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=starttls
# TLS modes: none (local plaintext), starttls (usually port 587),
# implicit (usually port 465; default when SMTP_TLS is unset).
# SMTP_FROM=Gossip Board <noreply@example.com>
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Production uses secure cookies by default and requires SMTP.
# COOKIE_SECURE=true

# Use X-Real-IP for sign-in rate limiting. compose.yaml already sets this,
# because the backend is only reachable through Nginx.
# TRUST_PROXY_HEADERS=true
